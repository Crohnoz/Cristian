{
  "version": "2026.08.1",
  "feature_flag": "cca-ai-mentor-live",
  "default_mode": "guided",
  "remote_provider_default": false,
  "allowed_modes": ["explain", "guided", "quiz", "debrief"],
  "pedagogy": {
    "hint_ladder": ["question", "conceptual_hint", "focused_hint", "worked_explanation"],
    "prefer_hints_before_answers": true,
    "require_debrief_after_lab": true,
    "max_consecutive_hints": 4
  },
  "context": {
    "tenant_scoped": true,
    "course_scoped": true,
    "lab_scoped": true,
    "external_web_default": false,
    "cross_tenant_retrieval": false
  },
  "privacy": {
    "send_prompts_to_product_analytics": false,
    "session_recording": false,
    "accept_secrets": false,
    "accept_credentials": false,
    "accept_pii_by_design": false,
    "retention_requires_policy": true
  },
  "cyber_safety": {
    "arbitrary_external_targets": false,
    "real_credentials": false,
    "real_session_tokens": false,
    "lab_targets_only": true,
    "prefer_defensive_learning": true,
    "tool_access_default": "none"
  },
  "observability": {
    "allowed_product_event": "mentor_topic",
    "allowed_event_properties": ["topic_category", "module", "lab", "result"],
    "raw_prompt_logging": false
  }
}
